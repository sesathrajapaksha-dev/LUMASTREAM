# Copy this to .env for local development
# In production, set these in Vercel Dashboard → Settings → Environment Variables

# Comma-separated list of valid Luma Keys
LUMA_KEYS=luma26,sesathr

# Secret token for admin API access (change this to something long and random!)
ADMIN_TOKEN=your-super-secret-admin-password-here

# Secret used to sign session tokens (change this too!)
TOKEN_SECRET=lumastream-random-secret-2026
